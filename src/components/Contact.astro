---
import { contact } from '../data/contact';
import ContactForm from '../islands/ContactForm';
---
<section id="contact" class="folio-section contact-section" aria-labelledby="contact-title">
  <div class="contact-intro" data-reveal>
    <h2 id="contact-title">Contact</h2>
    <p class="contact-description">For engineering roles or project inquiries, include the scope, technical requirements, and timeline.</p>
    <a class="contact-email" href={`mailto:${contact.email}`}>{contact.email} <span aria-hidden="true">↗</span></a>
    <div class="contact-socials">
      <a class="text-link" href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={contact.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <a class="contact-phone" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
  </div>
  <div class="letter-card" data-reveal>
    <div class="letter-heading"><span class="mono">Send an inquiry</span></div>
    <ContactForm client:load />
  </div>
</section>
