---
import { contact } from '../data/contact';
import ContactForm from '../islands/ContactForm';
---
<section id="contact" class="section contact-section container" aria-labelledby="contact-title">
  <div class="contact-layout">
    <div class="contact-intro" data-reveal>
      <span class="section-tag">Contact</span>
      <h2 id="contact-title">Let's Connect</h2>
      <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.7; margin-top: 14px;">
        I'm actively open to full-time engineering roles, high-impact contract work, and technical collaborations. Whether you have an open position or want to discuss architecture, my inbox is always open.
      </p>

      <div class="contact-channels">
        <a class="contact-channel-card" href={`mailto:${contact.email}`}>
          <div class="channel-info">
            <span class="channel-label">Email</span>
            <span class="channel-value">{contact.email}</span>
          </div>
          <span class="channel-action">Send email ↗</span>
        </a>

        <a class="contact-channel-card" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
          <div class="channel-info">
            <span class="channel-label">LinkedIn</span>
            <span class="channel-value">in/jayakrishnan-ps-6a23872a1</span>
          </div>
          <span class="channel-action">Connect ↗</span>
        </a>

        <a class="contact-channel-card" href={contact.github} target="_blank" rel="noopener noreferrer">
          <div class="channel-info">
            <span class="channel-label">GitHub</span>
            <span class="channel-value">github.com/jayakrishnanps</span>
          </div>
          <span class="channel-action">View code ↗</span>
        </a>

        <div class="contact-channel-card">
          <div class="channel-info">
            <span class="channel-label">Phone</span>
            <a class="channel-value" href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
          </div>
          <span class="channel-action" style="color: var(--text-dim); font-size: 0.8rem;">Direct line</span>
        </div>
      </div>

      <div class="contact-meta-row">
        <div class="contact-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span>Kerala, India (Open to Remote / Relocation)</span>
        </div>
        <div class="contact-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          <span>IST (UTC+5:30)</span>
        </div>
      </div>
    </div>

    <div class="contact-card" data-reveal>
      <div class="contact-card-header">
        <h3>Send a Message</h3>
        <p>I typically respond within 24 hours.</p>
      </div>
      <ContactForm client:load />
    </div>
  </div>
</section>
