---
import { contact } from '../data/contact';
import Portrait from './Portrait.astro';
---
<section id="hero" class="hero container" aria-labelledby="hero-title">
  <div class="hero-layout">
    <div class="hero-text">
      <div class="hero-status-pill" data-enter>
        <span class="status-indicator">
          <span class="status-dot"></span>
          <span class="status-pulse"></span>
        </span>
        <span>Available for full-time engineering roles</span>
      </div>
      
      <h1 id="hero-title" class="hero-name" data-enter>Jayakrishnan P S</h1>
      <p class="hero-role accent-gradient-text" data-enter>Full-Stack Engineer</p>
      
      <p class="hero-bio" data-enter>
        I build web applications and developer tools with clean architecture and practical ergonomics. Specialized in React, TypeScript, Python, and Django — from responsive interfaces to scalable backend APIs and desktop applications.
      </p>

      <div class="hero-actions" data-enter>
        <a href="#projects" class="btn-primary">
          View Projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <polyline points="19 12 12 19 5 12"></polyline>
          </svg>
        </a>
        <a href="#contact" class="btn-secondary">
          Get in Touch
        </a>
        <a href={contact.github} target="_blank" rel="noopener noreferrer" class="btn-secondary" aria-label="GitHub profile">
          GitHub ↗
        </a>
      </div>
    </div>

    <div class="hero-portrait-col" data-enter>
      <div class="hero-portrait-frame">
        <Portrait />
      </div>
    </div>
  </div>

  <div class="hero-meta-grid" data-enter>
    <div class="meta-card">
      <span class="meta-card-label">Primary Stack</span>
      <span class="meta-card-value">React · Django · TypeScript · Python</span>
    </div>
    <div class="meta-card">
      <span class="meta-card-label">Focus</span>
      <span class="meta-card-value">Web & Desktop Applications</span>
    </div>
    <div class="meta-card">
      <span class="meta-card-label">Education</span>
      <span class="meta-card-value">Master of Computer Applications (2025)</span>
    </div>
    <div class="meta-card">
      <span class="meta-card-label">Location</span>
      <span class="meta-card-value">Kerala, India</span>
    </div>
  </div>

  <div id="experience" class="experience-block" data-reveal>
    <div class="experience-block-header">
      <h2>Work Experience</h2>
      <span class="section-tag" style="margin: 0;">Timeline</span>
    </div>
    <div class="experience-item">
      <div class="experience-timeline">
        <span class="experience-badge">Internship</span>
        <span class="experience-date">Jun 2025 — Feb 2026</span>
      </div>
      <div class="experience-details">
        <h3>Software Engineer & Generative AI Intern</h3>
        <p>
          Architected and developed backend services and REST APIs for full-stack and generative AI products. Engineered streaming pipelines, database schemas, and robust endpoints for web and desktop clients, taking features from concept to production.
        </p>
        <div class="experience-tags">
          <span class="tag-pill">Python</span>
          <span class="tag-pill">Django</span>
          <span class="tag-pill">REST APIs</span>
          <span class="tag-pill">JavaScript</span>
          <span class="tag-pill">LLM Streaming</span>
          <span class="tag-pill">Full-Stack</span>
        </div>
      </div>
    </div>
  </div>
</section>
