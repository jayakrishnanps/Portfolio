---
import { contact } from '../data/contact';
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-meta" data-enter>
    <span class="mono hero-location">Kerala, India</span>
  </div>
  <h1 id="hero-title" class="hero-name" data-enter><span>Jayakrishnan</span> <i>P S</i></h1>
  <div class="hero-main" data-enter>
    <p class="hero-statement">React and Next.js interfaces backed by Django APIs and database-driven workflows.</p>
    <p class="hero-description">Built learning, inventory, and clinical applications with live video, usage-based recommendations, and document-to-test generation.</p>
    <div class="hero-links">
      <a href="#projects" class="primary-link">View projects <span class="link-icon" aria-hidden="true">↘</span></a>
      <a href={`mailto:${contact.email}`} class="primary-link secondary-link">Email me <span class="link-icon" aria-hidden="true">↗</span></a>
    </div>
  </div>
  <aside class="hero-aside" aria-labelledby="experience-title" data-enter>
    <div class="experience-heading"><h2 id="experience-title">Experience</h2><span class="mono">2025 — 26</span></div>
    <p class="experience-role">Software Engineer &<br />Generative AI Intern</p>
    <p class="experience-date mono">Jun 2025 – Feb 2026</p>
    <p class="experience-description">Developed backend services and REST APIs for full-stack and generative AI applications. Delivered product features from concept to production.</p>
    <p class="experience-stack">Python <span>/</span> Django <span>/</span> JavaScript</p>
  </aside>
  <div class="hero-colophon" data-enter>
    <p class="availability"><span class="status-dot" aria-hidden="true"></span> Available for full-time engineering roles</p>
    <span class="mono">MCA · 2025</span>
    <a href="#projects" class="section-jump" aria-label="Scroll to projects"><span aria-hidden="true">↓</span></a>
  </div>
</section>
