---
import { contact } from '../data/contact';
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-main">
    <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Full-stack developer <span class="small-rule" aria-hidden="true"></span></p>
    <div class="name-composition">
      <h1 id="hero-title">Jayakrishnan<br /><i>P S<span>.</span></i></h1>
    </div>
    <p class="hero-statement">React and Next.js interfaces backed by Django APIs and database-driven workflows.</p>
    <p class="hero-description">Built learning, inventory, and clinical applications with live video, usage-based recommendations, and document-to-test generation.</p>
    <div class="hero-links">
      <a href="#projects" class="text-link strong-link"><span class="status-dot" aria-hidden="true"></span> View projects <span aria-hidden="true">↘</span></a>
      <a href={`mailto:${contact.email}`} class="text-link">Email me <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <aside class="hero-aside" aria-label="Professional experience">
    <div class="practice-card">
      <div class="card-meta mono"><span>Jun 2025 – Feb 2026</span></div>
      <h2>Experience</h2>
      <p>Developed backend services and REST APIs for full-stack and generative AI applications. Delivered product features from concept to production.</p>
      <dl class="practice-facts">
        <div><dt>Role</dt><dd>Software Engineer & Generative AI Intern</dd></div>
        <div><dt>Stack</dt><dd>Python, Django & JavaScript</dd></div>
      </dl>
    </div>
    <div class="availability"><span class="availability-dot" aria-hidden="true"></span><p>Available for full-time software engineering roles.</p></div>
  </aside>
  <div class="hero-colophon"><span class="mono">Kerala, India</span><span class="mono">Master of Computer Applications · 2025</span></div>
</section>
