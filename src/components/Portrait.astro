---
import { Image } from 'astro:assets';
import portrait from '../assets/profilepicture.png';
import '../styles/portrait.css';
---
<div class="hero-portrait">
  <Image id="hero-portrait" src={portrait} alt="Jayakrishnan P S" width={512} height={512} widths={[256, 512, 768]} sizes="(max-width: 640px) 180px, (max-width: 980px) 220px, 300px" format="webp" quality={90} loading="eager" fetchpriority="high" />
</div>
