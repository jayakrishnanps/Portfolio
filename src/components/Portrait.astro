---
import { Image } from 'astro:assets';
import portrait from '../assets/profilepicture.png';
import '../styles/portrait.css';
---
<div class="hero-portrait">
  <Image id="hero-portrait" src={portrait} alt="Portrait of Jayakrishnan P S" width={512} height={512} widths={[256, 512, 768]} sizes="(max-width: 680px) 260px, 340px" format="webp" quality={85} loading="eager" fetchpriority="high" />
</div>
