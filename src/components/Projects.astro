---
import { getCollection } from 'astro:content';
import ProjectList from '../islands/ProjectList';
const projectOrder = ['orbit-ai', 'tutorva', 'ascent', 'athena', 'product-management-system', 'hospital-management-system'];
const position = (slug: string) => {
  const index = projectOrder.indexOf(slug);
  return index < 0 ? Number.MAX_SAFE_INTEGER : index;
};
const projects = (await getCollection('projects')).sort((a, b) => position(a.slug) - position(b.slug) || a.data.title.localeCompare(b.data.title));
const years = projects.flatMap((project) => (project.data.year?.match(/\d{4}/g) ?? []).map(Number));
const yearRange = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';
---
<section id="projects" class="folio-section work-section" aria-labelledby="work-title">
  <div class="section-heading" data-reveal>
    <div class="section-heading-main">
      <p class="eyebrow">Section 01 · The work desk</p>
      <h2 id="work-title">Selected <span class="work-title-cut">work.</span></h2>
    </div>
    <p class="section-meta mono">{String(projects.length).padStart(2, '0')} projects on record<br />{yearRange}</p>
  </div>
  <ProjectList projects={projects.map((project) => project.data)} />
</section>
