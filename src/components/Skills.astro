---
import SkillsFilter from '../islands/SkillsFilter';
import { skills } from '../data/skills';
---
<section id="skills" class="section skills-section container" aria-labelledby="skills-title">
  <div class="section-header" data-reveal>
    <span class="section-tag">Core Competencies</span>
    <h2 id="skills-title">Technical Skills</h2>
    <p>Languages, libraries, frameworks, and developer tooling I use daily to build production software.</p>
  </div>
  <SkillsFilter client:load skills={skills} />
</section>
