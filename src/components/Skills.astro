---
import SkillsFilter from '../islands/SkillsFilter';
import { skills } from '../data/skills';
---
<section id="skills" class="folio-section toolkit-section" aria-labelledby="toolkit-title">
  <div class="section-heading" data-reveal>
    <div class="desk-label"><span>02</span><p>The technical desk</p></div>
    <h2 id="toolkit-title">Tools of<br /><i>the trade.</i></h2>
    <p class="toolkit-intro">The languages, frameworks, and systems behind the work, from the browser to the database.</p>
    <span class="toolkit-footnote mono">15 entries / 5 categories</span>
  </div>
  <SkillsFilter client:load skills={skills} />
</section>
