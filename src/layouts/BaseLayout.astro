---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Motion from '../components/Motion.astro';
const title = 'Jayakrishnan P S — Full-Stack Developer';
const description = 'Full-stack developer building clean web applications, desktop tools, and robust backend systems with React, TypeScript, Python, and Django.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <div class="page-wrapper">
      <main id="main" tabindex="-1"><slot /></main>
      <footer class="site-footer container">
        <div>
          <p class="footer-brand">Jayakrishnan P S</p>
          <p class="footer-copy">Full-Stack Developer · Kerala, India · © {new Date().getFullYear()}</p>
        </div>
        <div class="footer-actions">
          <a class="footer-link" href="https://github.com/jayakrishnanps" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="footer-link" href="https://linkedin.com/in/jayakrishnan-ps-6a23872a1" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          <a class="back-to-top" href="#hero">Back to top ↑</a>
        </div>
      </footer>
    </div>
    <Motion />
  </body>
</html>
